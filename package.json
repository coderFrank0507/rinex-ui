{
	"name": "rinex-ui-root",
	"private": true,
	"type": "module",
	"scripts": {
		"dev:ui": "pnpm --filter rinex-ui dev",
		"dev:docs": "pnpm --filter @rinex-ui/docs dev",
		"dev:demo": "pnpm --filter @rinex-ui/demo dev",
		"lint": "eslint .",
		"spell": "cspell \"{components,docs}/**/*\"",
		"prepare": "husky",
		"commit": "cz"
	},
	"config": {
		"commitizen": {
			"path": "cz-git"
		}
	},
	"packageManager": "pnpm@10.13.1",
	"devDependencies": {
		"@commitlint/cli": "^20.4.2",
		"@commitlint/config-conventional": "^20.4.2",
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.3.0",
		"commitizen": "^4.3.1",
		"cspell": "^9.7.0",
		"cz-git": "^1.12.0",
		"eslint": "^10.0.2",
		"eslint-plugin-react-hooks": "^7.0.1",
		"globals": "^17.3.0",
		"husky": "^9.1.7",
		"jiti": "^2.6.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1"
	}
}
